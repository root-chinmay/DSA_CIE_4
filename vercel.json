{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "{frontend/**,backend/**,data/**}"
    },
    "main.py": {
      "includeFiles": "{frontend/**,backend/**,data/**}"
    }
  }
}
